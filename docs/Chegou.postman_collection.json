{
  "info": {
    "name": "Chegou API",
    "description": "Collection de testes da API Chegou.\n\nAntes de rodar: banco criado com db/schema-encomendas.sql e dados de teste com db/seed-dev.sql; API rodando (dotnet run). Ajuste a variável baseUrl se a porta for outra.\n\nA pasta 1 roda inteira sem IA (Run collection > só a pasta 1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Fluxo completo (sem IA)",
      "item": [
        {
          "name": "1.1 Listar pendentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/pendentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "pendentes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devolve uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Confirmar encomenda (manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fotoPath\": null,\n  \"etiqueta\": {\n    \"transportadora\": \"CORREIOS\",\n    \"destinatario\": \"Maria da Silva\",\n    \"bloco\": \"A\",\n    \"apartamento\": \"101\",\n    \"rastreio\": \"AA123456789BR\",\n    \"confianca\": 0.95,\n    \"problemas\": []\n  },\n  \"moradorId\": 1,\n  \"moradorSugeridoId\": 1,\n  \"scoreMatch\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Usa o morador 1 (Maria da Silva, bloco A apto 101) do seed-dev.sql. Guarda o id e o código de retirada nas variáveis da collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Tem id e código de retirada de 6 dígitos\", () => {",
                  "  pm.expect(r.id).to.be.a(\"number\");",
                  "  pm.expect(r.codigoRetirada).to.match(/^\\d{6}$/);",
                  "});",
                  "pm.test(\"Morador aceita notificação -> NOTIFICADA\", () => pm.expect(r.status).to.eql(\"NOTIFICADA\"));",
                  "pm.collectionVariables.set(\"encomendaId\", r.id);",
                  "pm.collectionVariables.set(\"codigoRetirada\", r.codigoRetirada);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Listar pendentes (deve conter a encomenda)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/pendentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "pendentes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const id = Number(pm.collectionVariables.get(\"encomendaId\"));",
                  "const item = pm.response.json().find(e => e.id === id);",
                  "pm.test(\"Encomenda aparece na lista\", () => pm.expect(item).to.exist);",
                  "pm.test(\"Veio com morador e unidade\", () => {",
                  "  pm.expect(item.morador).to.eql(\"Maria da Silva\");",
                  "  pm.expect(item.bloco).to.eql(\"A\");",
                  "  pm.expect(item.numero).to.eql(\"101\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Retirar com código errado (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/{{encomendaId}}/retirar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "{{encomendaId}}",
                "retirar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"abc123\",\n  \"retiradaPorNome\": \"Maria da Silva\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensagem de código inválido\", () => pm.expect(pm.response.json().erro).to.include(\"inválido\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Retirar com o código correto (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/{{encomendaId}}/retirar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "{{encomendaId}}",
                "retirar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoRetirada}}\",\n  \"retiradaPorNome\": \"Maria da Silva\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status RETIRADA\", () => pm.expect(pm.response.json().status).to.eql(\"RETIRADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Retirar de novo (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/{{encomendaId}}/retirar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "{{encomendaId}}",
                "retirar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoRetirada}}\",\n  \"retiradaPorNome\": \"Maria da Silva\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Listar pendentes (não deve conter mais)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/pendentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "pendentes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Number(pm.collectionVariables.get(\"encomendaId\"));",
                  "pm.test(\"Encomenda saiu da lista\", () => pm.expect(pm.response.json().some(e => e.id === id)).to.be.false);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Roda sem chave do Claude. Exige o seed-dev.sql aplicado. Execute em ordem (Run collection)."
    },
    {
      "name": "2. Leitura da etiqueta (usa a IA)",
      "item": [
        {
          "name": "2.1 Extrair etiqueta (foto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devolve nível e candidatos\", () => {",
                  "  pm.expect([\"Alto\", \"Medio\", \"Baixo\"]).to.include(r.nivel);",
                  "  pm.expect(r.candidatos).to.be.an(\"array\");",
                  "});",
                  "pm.collectionVariables.set(\"fotoPath\", r.fotoPath);",
                  "pm.collectionVariables.set(\"etiquetaJson\", JSON.stringify(r.etiqueta));",
                  "if (r.candidatos.length) {",
                  "  const top = r.candidatos[0];",
                  "  pm.collectionVariables.set(\"moradorId\", top.moradorId);",
                  "  pm.collectionVariables.set(\"moradorSugeridoId\", top.moradorId);",
                  "  pm.collectionVariables.set(\"scoreMatch\", top.score);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "foto",
                  "type": "file",
                  "src": [],
                  "description": "Selecione a foto da etiqueta (JPG/PNG)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/extrair",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "extrair"
              ]
            },
            "description": "Exige Claude:ApiKey configurada. Escolha uma foto no campo 'foto'. Sem chave ou com falha na leitura a API responde 422 com o caminho da foto salvo."
          }
        },
        {
          "name": "2.2 Confirmar com o resultado da extração",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fotoPath\": \"{{fotoPath}}\",\n  \"etiqueta\": {{etiquetaJson}},\n  \"moradorId\": {{moradorId}},\n  \"moradorSugeridoId\": {{moradorSugeridoId}},\n  \"scoreMatch\": {{scoreMatch}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Usa o primeiro candidato sugerido pela extração (variáveis preenchidas em 2.1). Depois dá para seguir com 1.4 / 1.5 para retirar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"encomendaId\", r.id);",
                  "pm.collectionVariables.set(\"codigoRetirada\", r.codigoRetirada);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Requer Claude:ApiKey (user-secrets) e uma foto real de etiqueta."
    },
    {
      "name": "3. Aprendizado de apelido",
      "item": [
        {
          "name": "3.1 Confirmar escolhendo morador diferente do sugerido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fotoPath\": null,\n  \"etiqueta\": {\n    \"transportadora\": \"MERCADO_LIVRE\",\n    \"destinatario\": \"JP Oliveira\",\n    \"bloco\": \"A\",\n    \"apartamento\": \"102\",\n    \"rastreio\": \"ML123456789\",\n    \"confianca\": 0.7,\n    \"problemas\": []\n  },\n  \"moradorId\": 2,\n  \"moradorSugeridoId\": null,\n  \"scoreMatch\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Simula o porteiro escolhendo manualmente o morador 2 (João Pedro Oliveira). O nome lido ('JP Oliveira') vira apelido dele. Confira no banco: SELECT * FROM MoradorApelido;"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Para ver o efeito, confira a tabela MoradorApelido no SQL Server depois de rodar."
    },
    {
      "name": "4. Casos de erro",
      "item": [
        {
          "name": "4.1 Confirmar com morador inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fotoPath\": null,\n  \"etiqueta\": {\n    \"transportadora\": \"CORREIOS\",\n    \"destinatario\": \"Maria da Silva\",\n    \"bloco\": \"A\",\n    \"apartamento\": \"101\",\n    \"rastreio\": \"AA123456789BR\",\n    \"confianca\": 0.95,\n    \"problemas\": []\n  },\n  \"moradorId\": 999999,\n  \"moradorSugeridoId\": 999999,\n  \"scoreMatch\": 0.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensagem de morador não encontrado\", () => pm.expect(pm.response.json().erro).to.include(\"Morador\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Retirar encomenda inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas/999999999/retirar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas",
                "999999999",
                "retirar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"123456\",\n  \"retiradaPorNome\": \"Fulano\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Confirmar com corpo inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encomendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encomendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request (validação automática)\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5234"
    },
    {
      "key": "moradorId",
      "value": "1"
    },
    {
      "key": "moradorSugeridoId",
      "value": "1"
    },
    {
      "key": "scoreMatch",
      "value": "1"
    },
    {
      "key": "fotoPath",
      "value": ""
    },
    {
      "key": "etiquetaJson",
      "value": "{\"destinatario\": \"Maria da Silva\", \"bloco\": \"A\", \"apartamento\": \"101\", \"confianca\": 0.9, \"problemas\": []}"
    },
    {
      "key": "encomendaId",
      "value": ""
    },
    {
      "key": "codigoRetirada",
      "value": ""
    }
  ]
}